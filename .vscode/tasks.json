{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Julia: Instantiate project",
            "type": "process",
            "command": "julia",
            "osx": {"command": "${env:HOME}/.juliaup/bin/julia"},
            "args": ["--project=.", "-e", "using Pkg; Pkg.instantiate()"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "Julia: Run tests",
            "type": "process",
            "command": "julia",
            "osx": {"command": "${env:HOME}/.juliaup/bin/julia"},
            "args": ["--project=.", "-e", "using Pkg; Pkg.test()"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "test", "isDefault": true},
            "problemMatcher": []
        }
    ]
}
